rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getRole() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userPath) ? get(userPath).data.role : '';
    }

    function isAdmin() {
      return isLoggedIn() && getRole() == 'admin';
    }

    function isTrainer() {
      return isLoggedIn() && getRole() == 'trainer';
    }

    function isAdminOrTrainer() {
      return isAdmin() || isTrainer();
    }

    // Users
    match /users/{userId} {
      allow read:   if isLoggedIn();
      allow create: if isLoggedIn() && request.auth.uid == userId;
      allow update: if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Terms
    match /terms/{id} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // Subjects
    match /subjects/{id} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // Assignments (subject ↔ class ↔ trainer)
    match /assignments/{id} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // Classes
    match /classes/{id} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    // Participation
    match /participation/{id} {
      allow read:             if isAdminOrTrainer()
                              || (isLoggedIn() && resource.data.studentId == request.auth.uid);
      allow create, update,
            delete:           if isAdminOrTrainer();
    }
  }
}
